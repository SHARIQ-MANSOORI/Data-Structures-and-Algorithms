#include <bits/stdc++.h>

using namespace std;

int sum(vector < int > & ans) {
    int summ = 0;
    for (int i = 0; i < ans.size(); i++) {
        summ += ans[i];
    }

    return summ;
}

void subsequenceEqualK(int i, vector < int > & arr, vector < int > & ans, int k) {
    if (i >= arr.size()) {
        // store
        if (sum(ans) == k) {
            for (int j = 0; j < ans.size(); j++) {
                cout << ans[j] << " ";
            }

            cout << endl;
        }

        return;
    }

    //take
    ans.push_back(arr[i]);
    subsequenceEqualK(i + 1, arr, ans, k);

    ans.pop_back();
    subsequenceEqualK(i + 1, arr, ans, k);
}

int main() {
    // your code goes here
    int n;
    cin >> n;
    vector <int> arr(n);

    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }
    int k;
    cin >> k;

    vector < int > ans;

    subsequenceEqualK(0, arr, ans, k);

}
