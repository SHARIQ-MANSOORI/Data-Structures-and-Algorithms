class Solution {
public:
    int maxScore(vector<int>& nums, int k) {

        int lsum = 0;
        int rsum = 0;
        int n = nums.size();
        int maxSum = 0;

        for(int i = 0 ; i < k ; i++){
                lsum += nums[i];
        }

        maxSum = max(maxSum , lsum);

        for(int i = 0 ; i < k ; i++){
            rsum += nums[n-i-1];
            lsum -= nums[k-i-1];

            maxSum = max(maxSum , rsum+lsum);

        }

        return maxSum;
        
    }
};
